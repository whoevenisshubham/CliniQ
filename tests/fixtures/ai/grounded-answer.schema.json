{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroundedAnswer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "answerKind",
    "answer",
    "facts",
    "definitions",
    "uncertainties",
    "citedSourceIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "answerKind": {
      "enum": [
        "grounded",
        "insufficient_evidence"
      ]
    },
    "answer": {
      "type": "string",
      "maxLength": 3000
    },
    "facts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidenceIds",
          "quotedSupport"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 600
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "quotedSupport": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidenceId",
                "quote"
              ],
              "properties": {
                "evidenceId": {
                  "type": "string",
                  "maxLength": 200
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "referenceId"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 600
          },
          "referenceId": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "citedSourceIds": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  }
}