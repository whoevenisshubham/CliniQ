# Copy to .env.local. Never commit credentials.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep both false until the owner configures and authorizes the isolated Google client.
GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
OCR_ENABLED=false
NEXT_PUBLIC_OCR_ENABLED=false
OCR_PROVIDER_VERIFIED=false
OCR_VISION_MODEL=qwen/qwen3.8-27b
# Required reconciled accounting/account ceilings; empty disables sends. No AI_OCR_MODEL alias.
OCR_ACCOUNTING_JSON=
LIVE_OCR_AUTHORIZATION_REF=
# Trusted server-side upload/content services, setup and workers only; never expose this key to clients.
SUPABASE_SERVICE_ROLE_KEY=
AI_ENABLED=false
GROQ_API_KEY=
AI_TEXT_MODEL=
# No live allowance is granted by configuration alone. Exact actor/patient scope and durable budget rows are also required.
LIVE_AI_AUTHORIZATION_REF=
# Retained Nova transport. All flags remain false until exact account/audio allowance is approved.
SPEECH_ENABLED=false
SPEECH_PROVIDER_VERIFIED=false
DEEPGRAM_API_KEY=
LIVE_SPEECH_AUTHORIZATION_REF=
AI_SPEECH_MODEL=nova-2
# Server-only, at least 32 characters. Missing dispatch leaves parsing queued for explicit recovery.
DOCUMENT_DISPATCH_SECRET=

