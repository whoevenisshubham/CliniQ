# Copy to .env.local. Never commit credentials.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Trusted server-side upload/content services, setup and workers only; never expose this key to clients.
SUPABASE_SERVICE_ROLE_KEY=
AI_ENABLED=false
GROQ_API_KEY=
AI_TEXT_MODEL=
# No live allowance is granted by configuration alone. Exact actor/patient scope and durable budget rows are also required.
LIVE_AI_AUTHORIZATION_REF=
# Reserved adapter setting; the speech transport remains unavailable.
AI_SPEECH_MODEL=
# Server-only, at least 32 characters. Missing dispatch leaves parsing queued for explicit recovery.
DOCUMENT_DISPATCH_SECRET=

